{
  "name": "exifcleaner",
  "private": true,
  "version": "4.7.0",
  "type": "module",
  "scripts": {
    "dev": "mobrowser dev",
    "dev:build": "mobrowser dev:build",
    "build": "mobrowser build",
    "pack": "mobrowser pack",
    "test": "mobrowser test:e2e",
    "test:e2e": "mobrowser test:e2e",
    "gen": "mobrowser gen",
    "add": "mobrowser add",
    "sbom": "mobrowser sbom",
    "agent": "mobrowser agent",
    "mobrowser": "mobrowser",
    "postinstall": "node scripts/prune_native_prebuilds.mjs",
    "typecheck": "mobrowser gen && tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'test/**/*.ts' 'scripts/*.mjs' '!src/*/gen/**'",
    "lint": "prettier --check 'src/**/*.{ts,tsx}' 'test/**/*.ts' 'scripts/*.mjs' '!src/*/gen/**'"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.2",
    "@mobrowser/api": "2.19.0",
    "@mobrowser/cli": "2.19.0",
    "exifcleaner-node": "0.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.0"
  },
  "optionalDependencies": {
    "@mobrowser/sdk-darwin-arm64": "2.19.0",
    "@mobrowser/sdk-darwin-x64": "2.19.0",
    "@mobrowser/sdk-linux-x64": "2.19.0",
    "@mobrowser/sdk-win-x64": "2.19.0"
  },
  "allowScripts": {
    "@mobrowser/sdk-darwin-arm64@2.19.0": true,
    "@mobrowser/sdk-darwin-x64@2.19.0": true,
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "3.9.10",
    "ts-proto": "^2.10.1",
    "typescript": "^5.8.3",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": "^20.20.2 || ^22.22.2 || >=24.14.1"
  },
  "description": "Clean exif metadata from images, media files, and PDF documents",
  "license": "MIT"
}
