{
  "app": {
    "name": "ExifCleaner",
    "version": {
      "major": "4",
      "minor": "7",
      "patch": "0"
    },
    "author": "szTheory",
    "copyright": "Copyright © szTheory",
    "description": "Clean exif metadata from images, media files, and PDF documents",
    "locales": [
      "en-US",
      "ar",
      "ca",
      "cs",
      "da",
      "de",
      "es",
      "fa",
      "fr",
      "hr",
      "hu",
      "it",
      "ja",
      "ml",
      "nl",
      "pl",
      "pt-BR",
      "pt-PT",
      "ro",
      "ru",
      "sk",
      "sv",
      "tr",
      "uk",
      "vi",
      "zh-CN"
    ],
    "trustedOrigins": [],
    "updateServerUrl": "",
    "schemes": [],
    "nodeModules": [
      "exifcleaner-node"
    ],
    "bundle": {
      "macOS": {
        "executableName": "ExifCleaner",
        "icon": "assets/app.icns",
        "bundleID": "com.exifcleaner",
        "extraInfo": "",
        "codesignIdentity": "${MAC_CODESIGN_IDENTITY}",
        "codesignEntitlements": "assets/entitlements.plist",
        "fileAssociations": [],
        "teamID": "${MAC_TEAM_ID}",
        "appleID": "${MAC_APPLE_ID}",
        "provisioningProfile": "",
        "password": "${MAC_APPLE_PASSWORD}",
        "extras": [
          {
            "from": "assets/exiftool/nix/bin/",
            "to": "Resources/nix/bin"
          }
        ],
        "installer": {
          "dmg": {
            "name": "",
            "volumeName": "",
            "volumeIcon": "assets/app.icns",
            "eula": "",
            "deltaStrategy": "BestSpeed",
            "window": {
              "textSize": 14,
              "skipPrettifying": false,
              "backgroundImage": "",
              "position": {
                "x": 500,
                "y": 400
              },
              "size": {
                "width": 600,
                "height": 400
              },
              "icon": {
                "size": 150,
                "position": {
                  "x": 160,
                  "y": 160
                }
              },
              "appDropLink": {
                "x": 430,
                "y": 160
              }
            }
          }
        }
      },
      "Windows": {
        "executableName": "ExifCleaner",
        "icon": "assets/app.ico",
        "signCommand": "",
        "fileAssociations": [],
        "extras": [
          {
            "from": "assets/exiftool/win/bin/",
            "to": "resources/win/bin"
          }
        ],
        "installer": {
          "exe": {
            "name": "",
            "icon": "assets/app.ico",
            "installationGif": "",
            "packageId": "ExifCleaner",
            "installationFolderName": "ExifCleaner",
            "displayName": "ExifCleaner",
            "shortcuts": "Desktop,StartMenuRoot",
            "deltaStrategy": "BestSpeed"
          }
        }
      },
      "Linux": {
        "executableName": "ExifCleaner",
        "icon": "assets/app.png",
        "fileAssociations": [],
        "extras": [
          {
            "from": "assets/exiftool/nix/bin/",
            "to": "resources/nix/bin"
          }
        ]
      }
    }
  },
  "automation": {
    "mode": "interactive"
  },
  "native": {
    "protobuf": {
      "mode": "auto",
      "toolchainMatch": "major"
    }
  }
}
